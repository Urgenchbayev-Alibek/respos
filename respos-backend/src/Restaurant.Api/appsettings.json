{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "respos",
    "Audience": "respos",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "PasswordResetTokenMinutes": 60,
    "InvitationDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshCookieSameSite": "Lax",
    "RefreshCookieSecure": true
  },
  "Frontend": {
    "AllowedOrigins": [],
    "AppUrl": "http://localhost:5173"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalRoot": "storage",
    "PublicBasePath": "/files"
  },
  "RateLimiting": {
    "GlobalPermitPerMinute": 300,
    "LoginPerMinute": 5,
    "AuthPerMinute": 20,
    "DemoRequestsPerHour": 5
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": true
  },
  "Seed": {
    "DemoData": false
  },
  "Housekeeping": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "IdempotencyRetentionHours": 24,
    "RefreshTokenRetentionDays": 30,
    "ExpiredTokenRetentionDays": 30,
    "ReadNotificationRetentionDays": 90
  },
  "Http": {
    "UseHttpsRedirection": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
