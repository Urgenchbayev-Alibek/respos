# Public values only — every VITE_* variable is embedded into the browser bundle. Never put secrets here.
VITE_API_BASE_URL=http://localhost:5080/api/v1
VITE_HUB_URL=http://localhost:5080/hubs/restaurant
# Both may also be root-relative (/api/v1, /hubs/restaurant) when the API is served from the app's own origin
# (desktop shell gateway, same-origin reverse proxy): they are resolved against the page origin at startup.
# Public landing site — table QR codes link to ${VITE_LANDING_URL}/menu/{branchSlug}?table={number}
VITE_LANDING_URL=http://localhost:5174
# Optional: app environment label shown in the UI (development | preview | production)
VITE_APP_ENV=development
# Desktop shell build only (respos-desktop sets it): no service worker / PWA. Leave unset for the web app.
# VITE_DESKTOP=true
