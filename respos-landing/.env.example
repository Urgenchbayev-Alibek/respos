# Public, non-secret configuration only. Never put secrets into VITE_* variables.
# Backend API base URL (including /api/v1). Example value, not a real address.
VITE_API_BASE_URL=http://localhost:5080/api/v1
# URL of the RestaurantOS web app (admin / staff workspaces) for the "Войти" link.
VITE_ADMIN_APP_URL=http://localhost:5173
# Public slug of the branch that receives online reservations on /booking (Settings → branch → "QR menu & delivery";
# the demo seed uses "demo"). Unset → "demo"; empty → the page shows a "booking is not connected yet" notice. Not a secret.
VITE_PUBLIC_BRANCH_SLUG=demo
